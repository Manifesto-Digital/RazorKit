@page "/razorkit/{componentName?}/{storyName?}"
@using Manifesto.RazorKit.Models
@using System.Reflection
@using System.Text.Json
@using Microsoft.AspNetCore.Html
@model Manifesto.RazorKit.Pages.RazorKitPageModel

@functions {
    private string SerializePropertyValue(object? value)
    {
        if (value == null)
            return "null";
            
        // Special handling for IHtmlContent - convert to HTML string
        if (value is IHtmlContent htmlContent)
        {
            using var writer = new StringWriter();
            htmlContent.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
            return JsonSerializer.Serialize(writer.ToString());
        }
        
        return JsonSerializer.Serialize(value);
    }
}

@{
    ViewBag.Title = "RazorKit";
    var components = Model.Components;
    var selectedComponent = Model.SelectedComponent;
    var selectedStory = Model.SelectedStory;
    var properties = Model.ComponentProperties;
    var defaultValues = Model.DefaultValues;
    var initialIframeUrl = Model.InitialIframeUrl;
    // The frame's accessible name, so a screen reader user knows which story the frame shows.
    var previewTitle = selectedComponent == null
        ? "Component preview"
        : "Component preview: " + selectedComponent.Name + (selectedStory != null ? " / " + selectedStory.DisplayName : "");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="razorkit-token" content="@Model.RequestToken">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="stylesheet" href="@Model.AssetUrl("css/razorkit.css")" />
</head>
<body class="razorkit-page">
    <div class="razorkit-layout">
        @* Landmarks are given as ARIA roles on the existing divs rather than as header/nav/main/aside
           elements: the consumer's own stylesheet is loaded into this page, and site rules for those
           elements (sticky headers, nav colours) would otherwise restyle RazorKit's chrome. *@
        <div class="razorkit-header" role="banner">
            @* The two panel toggles only show at the narrow breakpoint, where the sidebar and the
               controls become slide-over panels and only one may be open at a time. *@
            <button type="button" class="razorkit-panel-toggle" id="razorkit-components-toggle" data-razorkit-action="toggle-panel" data-razorkit-panel="components" aria-controls="razorkit-sidebar" aria-expanded="false">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                    <rect x="1" y="3" width="14" height="2" />
                    <rect x="1" y="7" width="14" height="2" />
                    <rect x="1" y="11" width="14" height="2" />
                </svg>
                <span>Components</span>
            </button>

            <div class="razorkit-logo" role="heading" aria-level="1"><span aria-hidden="true">📖</span> RazorKit</div>

            <button type="button" class="razorkit-panel-toggle" id="razorkit-controls-toggle" data-razorkit-action="toggle-panel" data-razorkit-panel="controls" aria-controls="razorkit-controls" aria-expanded="false">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                    <rect x="1" y="3" width="14" height="2" />
                    <circle cx="10" cy="4" r="2" />
                    <rect x="1" y="11" width="14" height="2" />
                    <circle cx="5" cy="12" r="2" />
                </svg>
                <span>Controls</span>
            </button>

            <button type="button" class="razorkit-show-controls-btn" data-razorkit-action="layout" data-razorkit-layout="side" title="Show Controls Panel" style="display: none;">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                    <rect x="1" y="1" width="10" height="14" stroke="currentColor" stroke-width="1" fill="none" />
                    <rect x="12" y="1" width="3" height="14" fill="currentColor" />
                </svg>
                <span>Show Controls</span>
            </button>

            <div class="razorkit-header-actions">
                <button type="button" class="razorkit-open-window-btn" data-razorkit-action="open-window" title="Open Component in New Window">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Z" />
                        <path d="M5.5 5.5A.5.5 0 0 1 6 5h2a.5.5 0 0 1 0 1H6.707l2.647 2.646a.5.5 0 0 1-.708.708L6 6.707V8a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Z" />
                        <path d="M10 2a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0V2.707l-2.146 2.147a.5.5 0 0 1-.708-.708L12.293 2H10.5A.5.5 0 0 1 10 2Z" />
                    </svg>
                    <span>Open</span>
                </button>
            </div>

            <div class="razorkit-viewport-controls">
                <select id="viewport-selector" class="razorkit-viewport-select" aria-label="Preview width">
                    <option value="responsive">📱 Responsive</option>
                    <option value="mobile">📱 Mobile (375px)</option>
                    <option value="tablet">📱 Tablet (768px)</option>
                    <option value="laptop">💻 Laptop (1024px)</option>
                    <option value="desktop">🖥️ Desktop (1440px)</option>
                    <option value="large">🖥️ Large (1920px)</option>
                </select>

                @if (Model.ShowThemeSelector)
                {
                    <span class="razorkit-theme-control">
                        <label class="razorkit-header-label" for="theme-selector">Theme</label>
                        <select id="theme-selector" class="razorkit-viewport-select" aria-label="Preview theme" title="Preview theme" autocomplete="off">
                            @foreach (var themeName in Model.ThemeNames)
                            {
                                <option value="@themeName" selected="@(themeName == Model.SelectedThemeName)">@themeName</option>
                            }
                        </select>
                    </span>
                }

                <div class="razorkit-viewport-info" id="viewport-info">
                    <span id="viewport-size">Responsive</span>
                </div>
            </div>
        </div>

        <div class="razorkit-sidebar" id="razorkit-sidebar" role="navigation" aria-label="Components">
            @if (components.Any())
            {
                <div class="razorkit-component-list">
                    @foreach (var group in components.GroupBy(c => c.AtomicLevel))
                    {
                        <div class="razorkit-component-group">
                            <div class="razorkit-component-group-title">@group.Key</div>
                            @foreach (var component in group.OrderBy(c => c.Name))
                            {
                                var componentStories = Model.GetStories(component.Name);
                                var isComponentSelected = selectedComponent?.Name == component.Name;

                                <div class="razorkit-component-section">
                                    <button type="button" class="razorkit-component-name @(isComponentSelected ? "active" : "")"
                                            data-razorkit-action="toggle-stories" data-razorkit-component="@component.Name.ToLower()"
                                            aria-expanded="@(isComponentSelected ? "true" : "false")" aria-controls="stories-@component.Name.ToLower()">
                                        <span class="razorkit-toggle-icon" aria-hidden="true">@(isComponentSelected ? "▼" : "▶")</span>
                                        @component.Name
                                    </button>

                                    <!-- Stories List -->
                                    <div class="razorkit-story-list @(isComponentSelected ? "expanded" : "")" id="stories-@component.Name.ToLower()">
                                        @foreach (var story in componentStories)
                                        {
                                            <a href="/razorkit/@component.Name.ToLower()/@story.Name.ToLower()@Model.ThemeQuery"
                                               data-razorkit-themed-link
                                               class="razorkit-story-item @(selectedStory?.Name == story.Name ? "active" : "")"
                                               title="@story.Description">
                                                @story.DisplayName
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Main Content -->
        <div class="razorkit-content">
            <div class="razorkit-preview" role="main">
                @if (selectedComponent != null)
                {
                    @if (selectedStory != null)
                    {
                        <div class="razorkit-story-header">
                            <h2 class="razorkit-story-title">
                                @selectedComponent.Name / @selectedStory.DisplayName
                            </h2>
                            @if (!string.IsNullOrEmpty(selectedStory.Description))
                            {
                                <p class="razorkit-story-description">@selectedStory.Description</p>
                            }
                        </div>
                    }

                    <div class="razorkit-preview-area">
                        <div class="razorkit-preview-container" id="component-preview">
                            @if (selectedComponent != null)
                            {
                                <iframe id="preview-iframe"
                                        name="preview-iframe"
                                        src="@initialIframeUrl"
                                        title="@previewTitle"
                                        frameborder="0"
                                        style="height: 600px; border: none; background: white;">
                                </iframe>
                            }
                            else
                            {
                                <div class="text-gray-500 text-center">
                                    <p>Select a component from the sidebar to view it</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="razorkit-preview-area">
                        <div class="razorkit-preview-container">
                            <div class="text-gray-500 text-center">
                                <p>Select a component from the sidebar to view it</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="razorkit-controls" id="razorkit-controls" role="complementary" aria-label="Controls">
                <div class="razorkit-control-section razorkit-layout-section">
                    <div class="razorkit-control-section-title">Layout</div>
                    <div class="razorkit-layout-controls">
                        <button type="button" data-razorkit-action="layout" data-razorkit-layout="side" title="Side Layout" class="razorkit-layout-btn active" id="layout-side">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                                <rect x="1" y="1" width="5" height="14" fill="currentColor" />
                                <rect x="7" y="1" width="8" height="14" stroke="currentColor" stroke-width="1" fill="none" />
                            </svg>
                            <span>Side</span>
                        </button>
                        <button type="button" data-razorkit-action="layout" data-razorkit-layout="bottom" title="Bottom Layout" class="razorkit-layout-btn" id="layout-bottom">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                                <rect x="1" y="1" width="14" height="8" stroke="currentColor" stroke-width="1" fill="none" />
                                <rect x="1" y="10" width="14" height="5" fill="currentColor" />
                            </svg>
                            <span>Bottom</span>
                        </button>
                        <button type="button" data-razorkit-action="layout" data-razorkit-layout="hidden" title="Hide Controls Panel" class="razorkit-layout-btn" id="layout-hidden">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                                <rect x="1" y="1" width="14" height="14" stroke="currentColor" stroke-width="1" fill="none" />
                                <line x1="5" y1="5" x2="11" y2="11" stroke="currentColor" stroke-width="2" />
                                <line x1="11" y1="5" x2="5" y2="11" stroke="currentColor" stroke-width="2" />
                            </svg>
                            <span>Hide</span>
                        </button>
                    </div>
                </div>

                @if (selectedComponent != null && properties.Any())
                {
                    <div class="razorkit-control-section">
                        <div class="razorkit-control-section-title">Properties</div>

                        <form id="component-form">

                            <input type="hidden" name="componentName" value="@selectedComponent.Name" />
                            <input type="hidden" name="storyName" value="@(selectedStory?.Name ?? "")" />

                            @foreach (var prop in properties)
                            {
                                <div class="razorkit-form-group">
                                    <label class="razorkit-form-label" for="razorkit-prop-@prop.Name">
                                        @prop.DisplayName
                                        @if (!string.IsNullOrEmpty(prop.Description))
                                        {
                                            <span class="text-xs text-gray-500">(@prop.Description)</span>
                                        }
                                    </label>

                                    @if (prop.Type == typeof(bool) || prop.Type == typeof(bool?))
                                    {
                                        <label class="razorkit-checkbox-label">
                                            <input type="checkbox"
                                                   id="razorkit-prop-@prop.Name"
                                                   class="razorkit-checkbox-control"
                                                   name="@prop.Name"
                                                   value="true"
                                                   @(Convert.ToBoolean(defaultValues.GetValueOrDefault(prop.Name, false)) ? "checked" : "") />
                                            <input type="hidden" name="@prop.Name" value="false" />
                                            <span>@prop.DisplayName</span>
                                        </label>
                                    }
                                    else if (prop.IsEnum && prop.EnumValues != null)
                                    {
                                        <select id="razorkit-prop-@prop.Name" name="@prop.Name" class="razorkit-form-control">
                                            @foreach (var enumValue in prop.EnumValues)
                                            {
                                                <option value="@enumValue"
                                                        @(defaultValues.GetValueOrDefault(prop.Name)?.ToString() == enumValue ? "selected" : "")>
                                                    @enumValue
                                                </option>
                                            }
                                        </select>
                                    }
                                    else if (prop.IsCollection || prop.IsComplexType)
                                    {
                                        var jsonValue = SerializePropertyValue(defaultValues.GetValueOrDefault(prop.Name));
                                        <textarea class="razorkit-form-control"
                                               id="razorkit-prop-@prop.Name"
                                               name="@prop.Name"
                                               rows="5"
                                               placeholder="Enter JSON for @prop.DisplayName.ToLower()"
                                               style="font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace; font-size: 0.8125rem;">@jsonValue</textarea>
                                        <small style="color: #6b7280; font-size: 0.75rem;">JSON format (e.g., [{"LinkText":"Home","LinkUrl":"/"}])</small>
                                    }
                                    else
                                    {
                                        <input type="text"
                                               id="razorkit-prop-@prop.Name"
                                               class="razorkit-form-control"
                                               name="@prop.Name"
                                               value="@(defaultValues.GetValueOrDefault(prop.Name)?.ToString() ?? "")"
                                               placeholder="Enter @prop.DisplayName.ToLower()" />
                                    }
                                </div>
                            }
                        </form>

                        @* The controls are rendered with the story's values over the component defaults, and
                           resetting restores exactly those. A page reload is not a reset: browsers may restore
                           edited values on reload, so there is no separate reload button. *@
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <button type="button" class="razorkit-reset-button" data-razorkit-action="reset-form">
                                @Model.ResetLabel
                            </button>
                        </div>
                    </div>

                    <div class="razorkit-control-section">
                        <div class="razorkit-control-section-title">Component Code</div>
                        @* Focusable so a keyboard user can scroll long lines sideways. *@
                        <div class="razorkit-component-code" id="component-code" tabindex="0" role="region" aria-label="Component code">
                            @{
                                var codeInstance = Model.CreateDefaultsInstance();
                                var propsJson = System.Text.Json.JsonSerializer.Serialize(codeInstance, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                            }
                            <div style="color: #047857;">@@await Html.PartialAsync("@selectedComponent.Path", new @(selectedComponent.Name)Props</div>
                            <div style="color: #dc2626;">{</div>
                            @foreach (var line in propsJson.Split('\n').Skip(1).Take(propsJson.Split('\n').Length - 2))
                            {
                                <div style="margin-left: 1rem;">@line</div>
                            }
                            <div style="color: #dc2626;">})</div>
                        </div>
                    </div>

                    <!-- Accessibility Panel -->
                    <div class="razorkit-a11y-panel">
                        <button type="button" class="razorkit-a11y-header" data-razorkit-action="toggle-a11y" aria-expanded="false" aria-controls="a11y-content">
                            <span><span aria-hidden="true">♿</span> Accessibility</span>
                            <span id="a11y-toggle-icon" aria-hidden="true">▶</span>
                        </button>
                        <div class="razorkit-a11y-content" id="a11y-content">
                            <div class="razorkit-a11y-summary">
                                <button type="button" class="razorkit-a11y-run-button" data-razorkit-action="run-a11y" id="a11y-run-button">
                                    Run Accessibility Test
                                </button>
                                <div id="a11y-summary" role="status"></div>
                            </div>
                            <div class="razorkit-a11y-issues" id="a11y-issues"></div>
                        </div>
                    </div>
                }
                else if (selectedComponent != null)
                {
                    <div class="razorkit-control-section">
                        <div class="razorkit-control-section-title">No Properties</div>
                        <p class="text-sm text-gray-600">This component doesn't have a Props class or no properties were found.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script type="application/json" id="razorkit-data">@Html.Raw(Model.PageDataJson())</script>
    <script src="@Model.AssetUrl("js/razorkit.js")"></script>
</body>
</html>
