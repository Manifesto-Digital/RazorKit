<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enable Razor Class Library features -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    
    <!-- This is a packable library -->
    <IsPackable>true</IsPackable>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Manifesto.RazorKit</PackageId>
    <Version>0.2.0</Version>
    <PackageReleaseNotes>0.2.0: security and reliability improvements. Upgrade by bumping the package version; no code changes are required.
- If your site runs behind a proxy or CDN, configure ASP.NET Core forwarded headers with your proxy's addresses so client IPs are correct, and set RazorKitOptions.AllowedOrigins to your public URL.
- MapRazorKit() is optional: if your site already calls MapControllers() and MapRazorPages(), you don't need it.
- axe-core is now bundled with the package; a CSP no longer needs to allow unpkg.com for RazorKit.
- The public constructors of RazorKit's controller, page model and services take additional parameters (affects only code that constructs them directly).
- When two stories share a name, the first one now wins.
- Rate-limit rejection logs identify clients by a short per-process tag, not by IP address.
- The preview's invalid-JSON message is now a fixed message; details are shown only in Development.
- Live editing in the Controls panel needs HTTPS, or localhost.
- If your site has its own Pages/RazorKit.cshtml (for example from an in-repo copy of RazorKit), delete it: it overrides the package's page.</PackageReleaseNotes>
    <Authors>Manifesto Digital</Authors>
    <Company>Manifesto Digital</Company>
    <Description>A component preview and development tool for ASP.NET Core Razor components. Provides an interactive UI for developing, testing, and documenting reusable Razor components, inspired by Storybook.</Description>
    <PackageTags>razor;components;storybook;preview;development;aspnetcore;manifesto</PackageTags>
    <PackageProjectUrl>https://github.com/manifesto-digital/razorkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/manifesto-digital/razorkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Generate symbols package for debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- The test project lives under this folder; keep its sources out of the package -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Suppress warnings -->
    <NoWarn>$(NoWarn);CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Manifesto.RazorKit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
