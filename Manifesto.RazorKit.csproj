<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enable Razor Class Library features -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    
    <!-- This is a packable library -->
    <IsPackable>true</IsPackable>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Manifesto.RazorKit</PackageId>
    <Version>0.4.0</Version>
    <PackageReleaseNotes>0.4.0: choose where RazorKit is served, and same-origin placeholder images. Upgrade by bumping the package version; nothing changes unless you opt in.
- EnabledEnvironments: set RazorKitOptions.EnabledEnvironments to the environments that should serve RazorKit, for example ["Development", "Staging"]. Names are matched ignoring case. In any other environment RazorKit's routes are not registered, so /razorkit and /razorkit-preview get the same 404 as any unknown URL, with no RazorKit headers or text. Unset (the default) serves RazorKit everywhere, as before. An empty list set in code turns RazorKit off everywhere, but an empty array in appsettings.json binds as unset, so list the environments you want instead. A blank entry stops the application at startup.
- Placeholder images: RazorKitPlaceholder.Url(width, height, label, background, foreground) returns a URL for an SVG placeholder served by RazorKit from your own origin, so stories no longer need third-party placeholder hosts that a strict Content-Security-Policy img-src blocks. Sizes are clamped to 16 to 4000 pixels, the label is limited to safe characters and 40 characters, and colours take hex values. Images are privately cached by the browser for a year and never by a shared cache or CDN.</PackageReleaseNotes>
    <Authors>Manifesto Digital</Authors>
    <Company>Manifesto Digital</Company>
    <Description>A component preview and development tool for ASP.NET Core Razor components. Provides an interactive UI for developing, testing, and documenting reusable Razor components, inspired by Storybook.</Description>
    <PackageTags>razor;components;storybook;preview;development;aspnetcore;manifesto</PackageTags>
    <PackageProjectUrl>https://github.com/manifesto-digital/razorkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/manifesto-digital/razorkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Generate symbols package for debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- The test project lives under this folder; keep its sources out of the package -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Suppress warnings -->
    <NoWarn>$(NoWarn);CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Manifesto.RazorKit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
